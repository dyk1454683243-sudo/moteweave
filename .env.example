OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Simple default provider selection. Keep keys in this local file or your shell;
# browser API responses never include raw keys.
# CHARACTER_IMAGE_PROVIDER=openrouter
# CHARACTER_IMAGE_PROVIDER=gemini
# CHARACTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# CHARACTER_IMAGE_API_KEY=
# CHARACTER_IMAGE_API_KEY_ENV=
# CHARACTER_IMAGE_BASE_URL=
# CHARACTER_IMAGE_SIZE=2K
# CHARACTER_IMAGE_ASPECT_RATIO=1:1

OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
OPENROUTER_IMAGE_SIZE=2K
GEMINI_IMAGE_SIZE=2K
OPENROUTER_IMAGE_ASPECT_RATIO=1:1
GEMINI_IMAGE_ASPECT_RATIO=1:1
OPENROUTER_SITE_URL=http://localhost:4173
OPENROUTER_APP_NAME=MoteWeave
CHARACTER_JOB_CONCURRENCY=2

# Optional: expose multiple preconfigured generation choices in the web UI.
# Keep keys in separate env vars; the browser only receives id/label/model/availability.
# CHARACTER_DEFAULT_PROVIDER=gemini25
# CHARACTER_PROVIDER_PRESETS=[{"id":"openrouter-gemini31","label":"Gemini 3.1 via OpenRouter","provider":"openrouter","apiKeyEnv":"OPENROUTER_API_KEY","model":"google/gemini-3.1-flash-image-preview","image_size":"2K"},{"id":"gemini-native","label":"Gemini API native","provider":"gemini","apiKeyEnv":"GEMINI_API_KEY","model":"gemini-3.1-flash-image-preview","image_size":"2K"}]
